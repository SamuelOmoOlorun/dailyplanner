{
  "name": "dailyplanner",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "check:dependencies": "expo install --check",
    "export:web": "expo export --platform web",
    "preview:web": "node scripts/preview-web.cjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "expo": "~57.0.30",
    "expo-notifications": "~57.0.23",
    "expo-sqlite": "~57.0.4",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
